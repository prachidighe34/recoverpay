
PORT=5000
NODE_ENV=development

# Use mongodb://localhost:27017/storechat when running Node directly,
# or mongodb://mongo:27017/storechat when running via docker-compose
# (docker-compose.yml already overrides this for you).
MONGO_URI=mongodb://localhost:27017/storechat

JWT_SECRET=zzzzzzzzzzzzzzzzzzzzzzzzzzz

# Razorpay TEST MODE keys — from Dashboard > Settings > API Keys > Test Mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_test_key_secret

# Dashboard > Settings > Webhooks > add endpoint > copy the webhook secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secrets